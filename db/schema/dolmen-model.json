              {
                "name": "total",
                "dataType": "numeric",
                "nullable": true,
                "default": null,
                "identity": null,
                "generated": null,
                "comment": null
              }
            ],
            "definition": " SELECT o.id AS order_id,\n    c.name AS customer,\n    sum(i.quantity::numeric * i.unit_price) AS total\n   FROM shop.orders o\n     JOIN shop.customers c ON c.id = o.customer_id\n     JOIN shop.order_items i ON i.order_id = o.id\n  GROUP BY o.id, c.name;",
